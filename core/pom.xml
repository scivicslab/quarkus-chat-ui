<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.scivicslab.chatui</groupId>
    <artifactId>quarkus-chat-ui-parent</artifactId>
    <version>2.4.0</version>
  </parent>
  <artifactId>chat-ui-core</artifactId>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.scivicslab</groupId>
      <artifactId>pojo-actor</artifactId>
    </dependency>
    <!-- Turing Workflow engine (Phase 3): the Interpreter / IIActorSystem that drives the Claude
         harness turn-by-turn (the "leash" workflows). -->
    <dependency>
      <groupId>com.scivicslab</groupId>
      <artifactId>turing-workflow</artifactId>
    </dependency>
    <!-- H2-backed complete I/O log (Sessions tab). Only the storage primitives are used
         (H2LogStore / H2LogReader / LogEntry / DistributedLogStore), which depend on H2 + org.json
         only. pojo-actor and turing-workflow are excluded so this does NOT pull a second pojo-actor
         version (this project stays on its own pojo-actor); the H2 classes never reference them. -->
    <dependency>
      <groupId>com.scivicslab.turingworkflow.plugins</groupId>
      <artifactId>plugin-log-db</artifactId>
      <version>1.6.0</version>
      <exclusions>
        <exclusion>
          <groupId>com.scivicslab</groupId>
          <artifactId>pojo-actor</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.scivicslab</groupId>
          <artifactId>turing-workflow</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.quarkiverse.mcp</groupId>
      <artifactId>quarkus-mcp-server-http</artifactId>
      <version>1.10.0</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
