<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.scivicslab.chatui</groupId>
    <artifactId>quarkus-chat-ui-parent</artifactId>
    <version>3.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>chat-ui-core</artifactId>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.scivicslab</groupId>
      <artifactId>pojo-actor</artifactId>
    </dependency>
    <!-- Turing Workflow engine (Phase 3): the Interpreter / IIActorSystem that drives the Claude
         harness turn-by-turn (the "leash" workflows). -->
    <dependency>
      <groupId>com.scivicslab</groupId>
      <artifactId>turing-workflow</artifactId>
    </dependency>
    <!-- H2-backed complete I/O log (Sessions tab). Only the storage primitives are used
         (H2LogStore / H2LogReader / LogEntry / DistributedLogStore), which depend on H2 + org.json
         only. pojo-actor and turing-workflow are excluded so this does NOT pull a second pojo-actor
         version (this project stays on its own pojo-actor); the H2 classes never reference them. -->
    <dependency>
      <groupId>com.scivicslab.turingworkflow.plugins</groupId>
      <artifactId>plugin-log-db</artifactId>
      <version>4.2.0</version>
      <exclusions>
        <exclusion>
          <groupId>com.scivicslab</groupId>
          <artifactId>pojo-actor</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.scivicslab</groupId>
          <artifactId>turing-workflow</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.quarkiverse.mcp</groupId>
      <artifactId>quarkus-mcp-server-http</artifactId>
      <version>1.10.0</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
      </plugin>
      <!-- action-schemas/*.schema.json for every @Action that declares argsType (ActionArgumentSchema_260807_oo01). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <dependencies>
          <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-generator</artifactId>
            <version>4.38.0</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>generate-action-schemas</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <includePluginDependencies>true</includePluginDependencies>
              <mainClass>com.scivicslab.pojoactor.action.schema.ActionSchemaGenerator</mainClass>
              <!-- Absolute paths: in a multi-module build the working directory is the reactor root. -->
              <arguments>
                <argument>${project.build.outputDirectory}</argument>
                <argument>${project.build.outputDirectory}/action-schemas</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- This module's action manifest: each @Action method's Javadoc (first sentence, body, <pre> example,
           @param prose), read back by ActionManifest (ActionCatalogWithJavadoc_260930_oo01). The resource is
           named after the module and indexed in a services file, because the uber-jar keeps only one entry
           per name and would drop every module's META-INF/turing-plugin.json but one. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>generate-plugin-manifest</id>
            <goals><goal>javadoc</goal></goals>
            <!-- Before the test phase, so tests see the manifest on the classpath as the app does. -->
            <phase>process-classes</phase>
            <configuration>
              <outputDirectory>${project.build.directory}/plugin-manifest-javadoc</outputDirectory>
              <reportOutputDirectory>${project.build.directory}/plugin-manifest-javadoc</reportOutputDirectory>
              <doclet>com.scivicslab.pojoactor.doclet.TuringPluginDoclet</doclet>
              <docletArtifact>
                <groupId>com.scivicslab</groupId>
                <artifactId>turing-workflow</artifactId>
                <version>${turing-workflow.version}</version>
              </docletArtifact>
              <useStandardDocletOptions>false</useStandardDocletOptions>
              <additionalOptions>
                <additionalOption>-turingClassesDir</additionalOption>
                <additionalOption>${project.build.outputDirectory}</additionalOption>
                <additionalOption>-turingManifestResource</additionalOption>
                <additionalOption>META-INF/turing-plugin/${project.groupId}.${project.artifactId}.json</additionalOption>
              </additionalOptions>
              <doclint>none</doclint>
              <failOnError>false</failOnError>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
